   "source": [
    "class Protocol(Enum):\n",
    "    DEFENCE = 0\n",
    "    ATTACK = 1\n",
    "    INTERFERENCE = 2\n",
    "\n",
    "class Colour(Enum):\n",
    "    YELLOW = 0\n",
    "    BLUE = 1\n",
    "\n",
    "class StartingPosition(Enum):\n",
    "    BACK_LEFT = 0\n",
    "    BACK_CENTRE = 1\n",
    "    BACK_RIGHT = 2\n",
    "    FRONT_LEFT = 3\n",
    "    FRONT_CENTRE = 4\n",
    "    FRONT_RIGHT = 5"
   ]
  }
