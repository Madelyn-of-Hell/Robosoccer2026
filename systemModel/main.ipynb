   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "\n",
    "class Robot:\n",
    "    @property\n",
    "    def has_ball(self) -> bool:...\n",
    "    @property\n",
    "    def distance_from_ball(self) -> float:...\n",
    "    @property\n",
    "    def angle_to_ball(self) -> float:...\n",
    "\n",
    "    @property\n",
    "    def teammate_has_ball(self) -> bool:...\n",
    "    @property\n",
    "    def teammate_protocol(self) -> Protocol:...\n",
    "    @property\n",
    "    def teammate_start_pos(self) -> StartingPosition:...\n",
    "    @property\n",
    "    def teammate_distance_from_ball(self) -> float:...\n",
    "    def __init__(self, starting_position:StartingPosition, team_colour:Colour):\n",
    "        self.starting_position = starting_position\n",
    "        self.team_colour = team_colour\n",
    "        self.current_position = (self.starting_position % 2, self.starting_position/3)\n",
    "        \n",
    "\n",
    "\n",
    "    def protocolSelector(self) -> Protocol:\n",
    "        team_start_pos = self.teammate_start_pos\n",
    "        team_protocol = self.teammate_protocol\n",
    "        if self.current_protocol == None:\n",
    "            match self.teammate_protocol:\n",
    "                case Protocol.DEFENCE:\n",
    "                    return Protocol.ATTACK\n",
    "                case Protocol.ATTACK:\n",
    "                    return Protocol.ATTACK\n",
    "                case Protocol.INTERFERENCE:\n",
    "                    return Protocol.ATTACK\n",
    "                case _:\n",
    "                    if self.starting_position == StartingPosition.FRONT_CENTRE:\n",
    "                        return Protocol.ATTACK\n",
    "                    elif team_start_pos == StartingPosition.FRONT_CENTRE:\n",
    "                        return Protocol.INTERFERENCE\n",
    "                    elif team_start_pos > self.starting_position:\n",
    "                        return Protocol.INTERFERENCE\n",
    "                    else:\n",
    "                        return Protocol.ATTACK\n",
    "        else:\n",
    "            match self.current_protocol:\n",
    "                case Protocol.ATTACK:\n",
    "                    if any(self.has_ball, self.teammate_has_ball):\n",
    "                        return Protocol.ATTACK\n",
    "                    else:\n",
    "                        if self.angle_to_ball > π/2 and self.angle_to_ball < 3*π/2:\n",
    "                            return Protocol.DEFENCE\n",
    "                        else: return Protocol.ATTACK\n",
    "                case Protocol.DEFENCE:\n",
    "                        if self.angle_to_ball < π/2 - π/6 and self.angle_to_ball < 3*π/2 + π/6:\n",
    "                            return Protocol.ATTACK\n",
    "                        else: return Protocol.DEFENCE\n"
   ],
  },
